---
interface Props {
  href: string;
  label: string;
  compact?: boolean;
}

const { href, label, compact = false } = Astro.props;
---

<a class:list={['next-chapter', { compact }]} href={href}>
  <span>Next</span>
  <strong>{label}</strong>
  <i aria-hidden="true">→</i>
</a>

<style>
  .next-chapter {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding: 1.2rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--paper-soft);
    text-decoration: none;
  }
  span, strong { font-family: var(--mono); text-transform: uppercase; }
  span { color: var(--paper-dim); font-size: .6rem; letter-spacing: .1em; }
  strong { font-size: .68rem; font-weight: 500; letter-spacing: .07em; }
  i { color: var(--amber); font-family: var(--serif); font-size: 1.25rem; font-style: normal; }
  .compact { grid-template-columns: auto auto auto; width: max-content; margin: 0; padding: 0; border: 0; }
  .compact span { padding-right: .35rem; }
  .next-chapter:hover strong { color: var(--paper); }
  @media (max-width: 760px) { .next-chapter:not(.compact) { grid-template-columns: 3.5rem 1fr auto; } }
</style>
