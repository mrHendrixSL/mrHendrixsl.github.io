---
import { homeChapters, type HomeChapterId } from '../../data/homeChapters';

interface Props {
  chapterMode?: boolean;
  activeChapter?: HomeChapterId;
}

const { chapterMode = false, activeChapter } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
  ['Home', '/'],
  ['Publications', '/publications/'],
  ['Talks', '/talks/'],
  ['Experience', '/experience/'],
  ['Notes', '/notes/']
];
const isActive = (href: string) => href === '/' ? pathname === '/' || chapterMode : pathname.startsWith(href);
---

<header class:list={['site-header', { 'chapter-header': chapterMode }]} data-site-header>
  <div class="nav-shell">
    <a class="wordmark" href="/" aria-label="R. Edirisinghe — home">
      <svg viewBox="0 0 44 44" aria-hidden="true">
        <circle cx="9" cy="29" r="2.8"/><circle cx="22" cy="12" r="2.8"/><circle cx="35" cy="28" r="2.8"/>
        <path d="M9 29 22 12l13 16M9 29l26-1"/>
      </svg>
      <span>R. Edirisinghe</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-nav-toggle>
      <span>Menu</span><i aria-hidden="true"></i>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="Primary" data-nav>
      <ul>
        {links.map(([label, href]) => (
          <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a></li>
        ))}
        <li><a href="/assets/Rasika_Edirisinghe-CV.pdf" target="_blank" rel="noopener noreferrer">CV <span aria-hidden="true">↗</span></a></li>
        {chapterMode && <li class="chapter-menu-label">Homepage chapters</li>}
        {chapterMode && homeChapters.map(chapter => (
          <li class="chapter-route-link"><a href={chapter.href} aria-current={activeChapter === chapter.id ? 'location' : undefined}><span>{chapter.index}</span>{chapter.railLabel}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const close = () => {
    toggle?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('nav-open');
  };
  toggle?.addEventListener('click', () => {
    const next = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(next));
    header?.classList.toggle('nav-open', next);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('nav-open')) {
      close(); toggle?.focus();
    }
  });
</script>

<style>
  .site-header { position: relative; z-index: 50; height: 5rem; border-bottom: 1px solid var(--rule); background: rgba(8,11,18,.88); backdrop-filter: blur(16px); }
  .site-header.chapter-header { position: sticky; top: 0; }
  .nav-shell { display: flex; align-items: center; justify-content: space-between; width: min(calc(100% - clamp(2rem, 6vw, 7rem)), var(--content)); height: 100%; margin-inline: auto; }
  .wordmark { display: inline-flex; align-items: center; gap: .7rem; color: var(--paper); font-family: var(--serif); font-size: 1.15rem; text-decoration: none; }
  .wordmark svg { width: 1.9rem; color: var(--indigo); fill: var(--ink-0); stroke: currentColor; stroke-width: 1; }
  .primary-nav ul { display: flex; gap: clamp(1rem, 2.3vw, 2rem); align-items: center; margin: 0; padding: 0; list-style: none; }
  .primary-nav a { position: relative; color: var(--paper-dim); font-family: var(--mono); font-size: .67rem; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; transition: color .25s ease; }
  .primary-nav a::after { position: absolute; right: 0; bottom: -.65rem; left: 0; height: 1px; background: var(--amber); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
  .primary-nav a:hover, .primary-nav a[aria-current='page'] { color: var(--paper); }
  .primary-nav a[aria-current='page']::after { transform: scaleX(1); }
  .nav-toggle { display: none; border: 0; background: transparent; color: var(--paper); font-family: var(--mono); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; }
  .chapter-menu-label, .chapter-route-link { display: none; }
  @media (max-width: 800px) {
    .nav-shell { width: calc(100% - 2rem); }
    .nav-toggle { display: flex; align-items: center; gap: .7rem; padding: .75rem 0 .75rem .75rem; }
    .nav-toggle i, .nav-toggle i::after { display: block; width: 1.3rem; height: 1px; background: currentColor; content: ''; transition: transform .25s ease; }
    .nav-toggle i::after { transform: translateY(5px); }
    .nav-open .nav-toggle i { transform: rotate(45deg); }
    .nav-open .nav-toggle i::after { transform: rotate(-90deg); }
    .primary-nav { position: absolute; top: 5rem; right: 0; left: 0; display: none; padding: 1.5rem 1rem 2rem; border-bottom: 1px solid var(--rule); background: var(--ink-1); }
    .nav-open .primary-nav { display: block; }
    .primary-nav ul { align-items: stretch; flex-direction: column; gap: 0; }
    .primary-nav a { display: block; padding: .72rem 0; font-size: .8rem; }
    .primary-nav a::after { display: none; }
    .chapter-menu-label {
      display: block;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--rule);
      color: var(--paper-dim);
      font-family: var(--mono);
      font-size: .62rem;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .chapter-route-link { display: block; }
    .chapter-route-link a { display: grid; grid-template-columns: 2rem 1fr; color: var(--paper-dim); }
    .chapter-route-link a[aria-current='location'] { color: var(--paper); }
    .chapter-route-link a[aria-current='location'] span { color: var(--amber); }
  }
</style>
