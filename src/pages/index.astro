---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterRail from '../components/layout/ChapterRail.astro';
import TransformationSequence from '../components/relation/TransformationSequence.svelte';
import ResearchArchitecture from '../components/relation/ResearchArchitecture.svelte';
import SectionHeading from '../components/layout/SectionHeading.astro';
import { profile } from '../data/profile';
import { updates } from '../data/updates';
import { projects } from '../data/projects';
import { getImage } from 'astro:assets';
import headshotSource from '../../assets/img/headshot.jpg';

const headshot = await getImage({ src: headshotSource, width: 112, height: 112, format: 'webp', quality: 80 });
const headshotRetina = await getImage({ src: headshotSource, width: 224, height: 224, format: 'webp', quality: 80 });
const latestUpdates = updates.filter(item => item.featured).slice(0, 3);
const nimbus = projects.find(project => project.id === 'nimbus-intrusted')!;
const exitLinks = [
  { label: 'Research', href: '/research/' },
  { label: 'Publications', href: '/publications/' },
  { label: 'Talks', href: '/talks/' },
  { label: 'Experience', href: '/experience/' }
];
---

<BaseLayout title="Rasika Edirisinghe" description={profile.description}>
  <ChapterRail />

  <section id="intro" class="homepage-chapter home-hero site-shell" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="chapter-kicker"><span>00</span> Identity</p>
      <h1 id="hero-heading">Rasika<br />Edirisinghe</h1>
      <p class="identity-role"><strong>{profile.role}</strong><span>{profile.institution}</span></p>
      <p class="hero-thesis">Textual relations<br /><em>under transformation.</em></p>
      <p class="hero-concept">{profile.conceptualStatement}</p>
      <nav class="profile-links" aria-label="Profile and contact links">
        {profile.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}
      </nav>
    </div>
    <figure class="portrait">
      <img src={headshot.src} srcset={`${headshot.src} 1x, ${headshotRetina.src} 2x`} width="112" height="112" alt="Portrait of Rasika Edirisinghe" decoding="async" fetchpriority="high" />
      <figcaption>UCC · Cork, Ireland</figcaption>
    </figure>
  </section>

  <section id="position" class="homepage-chapter content-section site-shell split-section position" aria-labelledby="position-heading">
    <div class="section-index"><span class="number">01</span><p class="section-kicker">Research position</p></div>
    <div>
      <h2 id="position-heading">{profile.question}</h2>
      <div class="position-copy">
        <p class="lead">My doctoral research examines <strong>textual relations under transformation</strong>: relationships that can persist through paraphrase, adaptation, obfuscation, allusion, historical variation, and other forms of textual change even as lexical overlap weakens.</p>
        <p>I investigate how those relations can be represented, retrieved, ranked, judged, and interpreted across large textual collections when matching words are no longer sufficient evidence.</p>
      </div>
      <a class="chapter-next" href="#transformation"><span>Next</span><strong>Relation under transformation</strong><i aria-hidden="true">↓</i></a>
    </div>
  </section>

  <div id="transformation" class="homepage-chapter transformation-chapter">
    <div class="site-shell">
      <TransformationSequence chapterIndex="02" client:visible />
      <a class="chapter-next" href="#architecture"><span>Next</span><strong>Research architecture</strong><i aria-hidden="true">↓</i></a>
    </div>
  </div>

  <section id="architecture" class="homepage-chapter content-section site-shell" aria-labelledby="architecture-heading">
    <SectionHeading index="03" kicker="Research architecture" title="A connected system for recovering relation beyond surface similarity" id="architecture-heading" description="With the transformation problem visible, the research moves from texts and representations to candidates, ranked relations, evidence, and visual exploration." />
    <ResearchArchitecture client:visible />
    <a class="chapter-next" href="#now"><span>Next</span><strong>Now</strong><i aria-hidden="true">↓</i></a>
  </section>

  <section id="now" class="homepage-chapter content-section site-shell now-chapter" aria-labelledby="now-heading">
    <SectionHeading index="04" kicker="Now / additional work" title="Current activity and further research" id="now-heading" />
    <div class="now-grid">
      <div class="latest-updates">
        <h3>Latest updates</h3>
        <ol>
          {latestUpdates.map(item => (
            <li>
              <time datetime={item.date}>{item.label}</time>
              <div><p>{item.content}</p>{item.href && <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.linkLabel}</a>}</div>
            </li>
          ))}
        </ol>
      </div>
      <article class="additional-work">
        <p class="section-kicker">Secondary research experience · {nimbus.dates}</p>
        <h3>{nimbus.title}</h3>
        <p class="strand-meta"><a href={nimbus.href} target="_blank" rel="noopener noreferrer">{nimbus.context}</a></p>
        <p>{nimbus.description}</p>
      </article>
    </div>
    <nav class="exit-links" aria-label="Explore the website">
      <span>Continue exploring</span>
      {exitLinks.map(link => <a href={link.href}>{link.label}<i aria-hidden="true">→</i></a>)}
    </nav>
  </section>
</BaseLayout>

<style>
  :global(html) { scroll-snap-type: y proximity; }
  .homepage-chapter { scroll-snap-align: start; }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: clamp(3rem, 9vw, 10rem); min-height: calc(100svh - 5rem); padding: clamp(4rem, 8vh, 7rem) 0; align-items: center; }
  .hero-copy { min-width: 0; }
  .chapter-kicker { display: flex; gap: .8rem; align-items: baseline; color: var(--paper-dim); font-family: var(--mono); font-size: .67rem; letter-spacing: .12em; text-transform: uppercase; }
  .chapter-kicker span { color: var(--indigo); font-family: var(--serif); font-size: 1.5rem; font-style: italic; letter-spacing: 0; }
  .hero-copy h1 { margin: 1.1rem 0 1.5rem; }
  .identity-role { display: grid; gap: .12rem; margin: 0 0 clamp(2.4rem, 5vh, 4rem); color: var(--paper-soft); font-family: var(--mono); font-size: .7rem; letter-spacing: .08em; line-height: 1.6; text-transform: uppercase; }
  .identity-role strong { color: var(--amber); font-weight: 500; }
  .hero-thesis { margin: 0; color: var(--paper); font-family: var(--serif); font-size: clamp(2rem, 4vw, 4.2rem); line-height: .98; letter-spacing: -.035em; }
  .hero-thesis em { color: var(--indigo); font-weight: 350; }
  .hero-concept { margin: 1.6rem 0; color: var(--paper-dim); font-family: var(--mono); font-size: .67rem; letter-spacing: .09em; text-transform: uppercase; }
  .profile-links { display: flex; flex-wrap: wrap; gap: .55rem 1.2rem; max-width: 34rem; }
  .profile-links a { color: var(--paper-soft); font-family: var(--mono); font-size: .67rem; letter-spacing: .06em; text-transform: uppercase; }
  .portrait { align-self: end; display: grid; gap: .8rem; justify-items: end; margin: 0 0 1rem; }
  .portrait img { width: 7rem; height: 7rem; border: 1px solid var(--rule-strong); filter: grayscale(1) contrast(1.04); object-fit: cover; }
  .portrait figcaption { color: var(--paper-dim); font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .position h2 { max-width: 17ch; }
  .position-copy { max-width: 49rem; margin-top: 3rem; text-align: left; hyphens: auto; }
  .position-copy .lead { color: var(--paper); font-family: var(--serif); font-size: clamp(1.3rem, 2.15vw, 1.8rem); line-height: 1.4; }
  .position-copy strong { font-weight: 500; }
  .chapter-next { display: grid; grid-template-columns: 4rem 1fr auto; gap: 1rem; align-items: center; margin-top: clamp(3rem, 7vw, 6rem); padding: 1.2rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); color: var(--paper-soft); text-decoration: none; }
  .chapter-next span { color: var(--paper-dim); font-family: var(--mono); font-size: .56rem; letter-spacing: .1em; text-transform: uppercase; }
  .chapter-next strong { font-family: var(--mono); font-size: .67rem; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; }
  .chapter-next i { color: var(--amber); font-family: var(--serif); font-size: 1.25rem; font-style: normal; }
  .transformation-chapter { border-top: 1px solid var(--rule); }
  .transformation-chapter .chapter-next { margin-top: 0; }
  #architecture { border-top: 1px solid var(--rule); }
  #architecture .chapter-next { margin-top: clamp(3rem, 6vw, 5rem); }
  .now-chapter { border-top: 1px solid var(--rule); }
  .now-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(18rem, .65fr); gap: clamp(3rem, 8vw, 8rem); }
  .latest-updates h3, .additional-work h3 { font-size: clamp(1.8rem, 3vw, 2.6rem); }
  .latest-updates ol { margin: 2rem 0 0; padding: 0; list-style: none; }
  .latest-updates li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1.5rem; padding: 1.35rem 0; border-top: 1px solid var(--rule); }
  .latest-updates li:last-child { border-bottom: 1px solid var(--rule); }
  .latest-updates time { color: var(--amber); font-family: var(--mono); font-size: .62rem; letter-spacing: .07em; text-transform: uppercase; }
  .latest-updates p { margin: 0; color: var(--paper-soft); font-size: .88rem; line-height: 1.6; }
  .latest-updates .text-link { margin-top: .65rem; font-size: .62rem; }
  .additional-work { align-self: start; padding-top: 1.4rem; border-top: 1px solid var(--rule-strong); }
  .additional-work h3 { max-width: 17ch; margin: 1rem 0 1.3rem; }
  .additional-work > p:last-child { margin-top: 1.4rem; font-size: .88rem; line-height: 1.65; }
  .strand-meta { color: var(--amber); font-family: var(--mono); font-size: .61rem; letter-spacing: .06em; line-height: 1.6; text-transform: uppercase; }
  .exit-links { display: grid; grid-template-columns: minmax(10rem, 1fr) repeat(4, auto); gap: 1rem 2rem; align-items: center; margin-top: clamp(4rem, 8vw, 7rem); padding: 1.4rem 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .exit-links > span { color: var(--paper-dim); font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .exit-links a { display: inline-flex; gap: .55rem; align-items: center; color: var(--paper-soft); font-family: var(--mono); font-size: .66rem; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
  .exit-links i { color: var(--amber); font-style: normal; }
  @media (max-width: 900px) {
    .home-hero { grid-template-columns: 1fr; }
    .hero-copy { max-width: 48rem; }
    .portrait { align-self: auto; justify-self: end; margin-top: -8rem; }
    .now-grid { grid-template-columns: 1fr; }
    .additional-work { max-width: 43rem; }
    .exit-links { grid-template-columns: repeat(2, 1fr); }
    .exit-links > span { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .home-hero { min-height: auto; padding-top: 3.5rem; }
    .hero-copy h1 { font-size: clamp(3.65rem, 17vw, 5.4rem); }
    .portrait { justify-self: start; justify-items: start; margin: 1rem 0 0; }
    .position-copy { margin-top: 2rem; }
    .chapter-next { grid-template-columns: 3.5rem 1fr auto; }
    .latest-updates li { grid-template-columns: 1fr; gap: .45rem; }
    .exit-links { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-snap-type: none; } }
</style>
