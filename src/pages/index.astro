---
import HomeChapterLayout from '../layouts/HomeChapterLayout.astro';
import NextChapter from '../components/layout/NextChapter.astro';
import ToolOrbit from '../components/home/ToolOrbit.svelte';
import { profile } from '../data/profile';
import { getImage } from 'astro:assets';
import headshotSource from '../../assets/img/headshot.jpg';

const headshot = await getImage({ src: headshotSource, width: 176, height: 176, format: 'webp', quality: 82 });
const headshotRetina = await getImage({ src: headshotSource, width: 352, height: 352, format: 'webp', quality: 82 });
---

<HomeChapterLayout active="intro" description={profile.description}>
  <section id="intro" class="chapter-page home-hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="chapter-kicker"><span>00</span> Identity</p>
      <h1 id="hero-heading">Rasika<br />Edirisinghe</h1>
      <p class="identity-role"><strong>{profile.role}</strong><span>{profile.institution}</span></p>
      <p class="hero-thesis">Textual relations<br /><em>under transformation.</em></p>
      <p class="hero-concept">Representation · Retrieval · Judgement · Interpretation</p>
      <nav class="profile-links" aria-label="Profile and contact links">
        {profile.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}
      </nav>
    </div>

    <div class="trade-visual"><ToolOrbit client:visible /></div>

    <figure class="portrait">
      <img src={headshot.src} srcset={`${headshot.src} 1x, ${headshotRetina.src} 2x`} width="176" height="176" alt="Portrait of Rasika Edirisinghe" decoding="async" fetchpriority="high" />
      <figcaption>UCC · Cork, Ireland</figcaption>
    </figure>

    <div class="hero-next"><NextChapter href="/position/" label="Research position" compact /></div>
  </section>

  <script is:inline>
    const legacyChapterRoutes = { '#position': '/position/', '#transformation': '/transformation/', '#architecture': '/architecture/', '#now': '/now/' };
    const legacyRoute = legacyChapterRoutes[window.location.hash];
    if (legacyRoute) window.location.replace(legacyRoute);
  </script>
</HomeChapterLayout>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(24rem, .8fr) minmax(32rem, 1.2fr);
    grid-template-rows: 1fr auto;
    gap: 2rem clamp(4rem, 8vw, 9rem);
    align-items: center;
    padding: clamp(4rem, 8vh, 6rem) 0 2.2rem;
  }
  .hero-copy { min-width: 0; align-self: start; }
  .hero-copy h1 { max-width: 8ch; margin: 1rem 0 1.35rem; font-size: clamp(3.1rem, 3.7vw, 3.85rem); }
  .identity-role { display: grid; gap: .08rem; margin: 0 0 clamp(2.5rem, 5vh, 4rem); color: var(--paper-soft); font-family: var(--mono); font-size: .72rem; letter-spacing: .08em; line-height: 1.7; text-transform: uppercase; }
  .identity-role strong { color: var(--amber); font-weight: 500; }
  .hero-thesis { margin: 0; color: var(--paper); font-family: var(--serif); font-size: clamp(2.2rem, 2.8vw, 3.15rem); line-height: 1; letter-spacing: -.03em; }
  .hero-thesis em { color: var(--indigo); font-weight: 350; }
  .hero-concept { margin: 1.75rem 0; color: var(--paper-dim); font-family: var(--mono); font-size: .67rem; letter-spacing: .09em; text-transform: uppercase; }
  .profile-links { display: flex; flex-wrap: wrap; gap: .6rem 2.5rem; max-width: 56rem; }
  .profile-links a { color: var(--paper-soft); font-family: var(--mono); font-size: .69rem; letter-spacing: .06em; text-transform: uppercase; }
  .trade-visual { grid-column: 2; grid-row: 1; align-self: center; min-width: 0; padding-right: 5rem; }
  .portrait { position: absolute; right: 0; bottom: 6.5rem; display: grid; gap: .55rem; justify-items: end; margin: 0; z-index: 2; }
  .portrait img { width: 7rem; height: 7rem; border: 1px solid var(--rule-strong); filter: grayscale(1) contrast(1.04); object-fit: cover; }
  .portrait figcaption { color: var(--paper-dim); font-family: var(--mono); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  .hero-next { grid-column: 1 / -1; align-self: end; }

  @media (max-width: 1180px) {
    .home-hero { grid-template-columns: minmax(20rem, .85fr) minmax(27rem, 1.15fr); }
    .trade-visual { padding-right: 2rem; }
    .portrait img { width: 6rem; height: 6rem; }
  }

  @media (max-width: 800px) {
    .home-hero { grid-template-columns: 1fr; grid-template-rows: auto; gap: .55rem; padding: .8rem 0 .7rem; }
    .hero-copy h1 { margin-block: .55rem .8rem; font-size: clamp(2.2rem, 9.4vw, 2.55rem); }
    .identity-role { margin-bottom: 1.25rem; }
    .hero-thesis { font-size: clamp(1.7rem, 7.4vw, 2.2rem); }
    .hero-concept { max-width: 23rem; margin-block: .7rem; line-height: 1.65; }
    .profile-links { gap: .55rem 1.25rem; }
    .trade-visual { grid-column: 1; grid-row: auto; width: 100%; padding: 0; }
    .portrait { right: 0; bottom: 4.8rem; }
    .portrait img { width: 4.25rem; height: 4.25rem; }
    .portrait figcaption { display: none; }
    .hero-next { grid-column: 1; margin-top: .25rem; }
  }

  @media (min-width: 801px) and (max-height: 820px) {
    .home-hero { padding-top: 2.5rem; }
    .hero-copy h1 { font-size: clamp(3rem, 3.6vw, 3.7rem); }
    .identity-role { margin-bottom: 1.8rem; }
    .hero-thesis { font-size: clamp(2rem, 2.7vw, 2.7rem); }
    .portrait { margin-bottom: 2rem; }
    .portrait img { width: 8rem; height: 8rem; }
  }
</style>
