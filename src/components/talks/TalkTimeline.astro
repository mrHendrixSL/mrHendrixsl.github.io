---
import type { TimelineItem } from '../../data/talks';
interface Props { items: TimelineItem[]; }
const { items } = Astro.props;
---
<ol class="talk-timeline">
  {items.map((item) => (
    <li>
      <time datetime={item.date}>{item.dateLabel}</time>
      <article>
        <h3>{item.title}</h3>
        <p class="event">{item.event}{item.location && ` · ${item.location}`}</p>
        <details class="talk-details"><summary>Details</summary><p>{item.description} {item.href && <a href={item.href} target="_blank" rel="noopener noreferrer">{item.linkLabel} ↗</a>}</p></details>
      </article>
    </li>
  ))}
</ol>

<style>
  .talk-timeline { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 5rem); margin: 0; padding: 0; list-style: none; }
  .talk-timeline li { position: relative; display: grid; grid-template-columns: 7rem minmax(0,1fr); gap: 1.4rem; padding: 1.45rem 0 1.8rem; border-top: 1px solid var(--rule); }
  time, .event { color: var(--paper-dim); font-family: var(--mono); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; }
  article { padding-left: 0; }
  h3 { max-width: 32ch; font-size: clamp(1.35rem, 1.8vw, 1.75rem); }
  .event { margin: .65rem 0 .75rem; color: var(--amber); }
  .talk-details summary { color: var(--paper-soft); font-family: var(--mono); font-size: .62rem; letter-spacing: .07em; text-transform: uppercase; cursor: pointer; }
  .talk-details summary::marker { color: var(--amber); }
  .talk-details p { max-width: 45rem; margin: .65rem 0 0; font-size: .92rem; line-height: 1.55; }
  @media (max-width: 900px) { .talk-timeline { grid-template-columns: 1fr; } }
  @media (max-width: 650px) { .talk-timeline li { grid-template-columns: 1fr; gap: .45rem; padding: 1.25rem 0 1.45rem; } }
</style>
