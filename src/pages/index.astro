---
import BaseLayout from '../layouts/BaseLayout.astro';
import RelationField from '../components/relation/RelationField.svelte';
import TransformationSequence from '../components/relation/TransformationSequence.svelte';
import ResearchArchitecture from '../components/relation/ResearchArchitecture.svelte';
import SectionHeading from '../components/layout/SectionHeading.astro';
import { profile } from '../data/profile';
import { updates } from '../data/updates';
import { getImage } from 'astro:assets';
import headshotSource from '../../assets/img/headshot.jpg';
const headshot = await getImage({ src: headshotSource, width: 96, height: 96, format: 'webp', quality: 80 });
const headshotRetina = await getImage({ src: headshotSource, width: 192, height: 192, format: 'webp', quality: 80 });
---

<BaseLayout title="Rasika Edirisinghe" description={profile.description}>
  <section class="home-hero site-shell" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">{profile.role} · {profile.institution}</p>
      <h1 id="hero-heading">Rasika<br />Edirisinghe</h1>
      <p class="hero-thesis">Textual relations<br /><em>under transformation.</em></p>
      <p class="hero-concept">{profile.conceptualStatement}</p>
      <nav class="profile-links" aria-label="Profile and contact links">
        {profile.links.map(link => <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}</a>)}
      </nav>
    </div>
    <div class="hero-visual">
      <RelationField client:visible />
      <figure class="portrait">
        <img src={headshot.src} srcset={`${headshot.src} 1x, ${headshotRetina.src} 2x`} width="96" height="96" alt="Portrait of Rasika Edirisinghe" decoding="async" fetchpriority="high" />
        <figcaption>UCC · Cork, Ireland</figcaption>
      </figure>
    </div>
    <blockquote>{profile.question}</blockquote>
  </section>

  <section class="content-section site-shell split-section about" aria-labelledby="about-heading">
    <div class="section-index"><span class="number">01</span><p class="section-kicker">Research position</p></div>
    <div>
      <h2 id="about-heading">About the work</h2>
      <div class="about-copy">
        <p class="lead">I am a doctoral researcher in Computer Science at University College Cork, funded through the <a href="https://www.horizoncascade.net/" target="_blank" rel="noopener noreferrer">CASCADE</a> Horizon Europe Marie Skłodowska-Curie Doctoral Network. My research focuses on the <strong>computational representation and retrieval of textual relations under transformation</strong>, with particular attention to cases in which lexical similarity is weakened or lost through paraphrase, adaptation, obfuscation, allusion, historical variation, and other forms of textual change.</p>
        <p>My current work examines how such relations can be encoded, retrieved, ranked, and evaluated at scale across large textual collections. This includes research on semantic retrieval, parallel-text modelling, relation judgement, benchmark construction, and visual analytics. A central concern is how computational methods can recover evidence of textual relatedness across different degrees and forms of transformation.</p>
        <p>Prior to my doctoral research, I worked for more than four years in data analytics and implementation engineering, developing business intelligence systems, automation pipelines, and real-time analytical platforms.</p>
        <p>From April to July 2026, I completed a research secondment at Nimbus Research Centre, MTU, on the <a href="https://nimbuscentre.ie/project/intrusted/" target="_blank" rel="noopener noreferrer">inTrusted</a> project, investigating grounding and trust in agentic cyber-physical systems. The work examined how conversational AI failures can propagate from language understanding through planning and tool use into physical robotic action.</p>
      </div>
    </div>
  </section>

  <section class="content-section site-shell" aria-labelledby="recent-heading">
    <SectionHeading kicker="Field notes" title="Recent updates" id="recent-heading" />
    <ol class="updates">
      {updates.filter(item => item.featured).map(item => (
        <li>
          <time datetime={item.date}>{item.label}</time>
          <div><p>{item.content}</p>{item.href && <a class="text-link" href={item.href} target="_blank" rel="noopener noreferrer">{item.linkLabel}</a>}</div>
        </li>
      ))}
    </ol>
  </section>

  <section class="content-section site-shell" aria-labelledby="architecture-heading">
    <SectionHeading index="02" kicker="Doctoral research architecture" title="A connected system for recovering relation beyond surface similarity" id="architecture-heading" description="Representation, retrieval, judgement, and visual analytics form one research trajectory rather than isolated methods." />
    <ResearchArchitecture client:visible />
  </section>

  <div class="site-shell"><TransformationSequence client:visible /></div>

  <aside class="secondary-strand site-shell" aria-labelledby="secondary-heading">
    <div class="strand-marker" aria-hidden="true"><i></i><i></i><i></i></div>
    <div>
      <p class="section-kicker">Additional research experience · Apr–Jul 2026</p>
      <h2 id="secondary-heading">Grounding and Trust in Agentic Cyber-Physical Systems</h2>
      <p class="strand-meta">Nimbus Research Centre · Munster Technological University</p>
      <p>Research conducted during the <a href="https://nimbuscentre.ie/project/intrusted/" target="_blank" rel="noopener noreferrer">inTrusted project</a> secondment on how failures in conversational AI can propagate through planning and tool use into physical action.</p>
    </div>
  </aside>
</BaseLayout>

<style>
  .home-hero { position: relative; display: grid; grid-template-columns: minmax(22rem,.82fr) minmax(32rem,1.18fr); gap: clamp(2rem,4vw,5rem); min-height: calc(100svh - 5rem); padding: clamp(4rem,8vh,7rem) 0 4rem; align-items: center; }
  .hero-copy { position: relative; z-index: 2; min-width: 0; }
  .hero-copy h1 { margin: 1.1rem 0 2.4rem; }
  .hero-thesis { margin: 0; color: var(--paper); font-family: var(--serif); font-size: clamp(2rem,4.2vw,4.4rem); line-height: .96; letter-spacing: -.035em; }
  .hero-thesis em { color: var(--indigo); font-weight: 350; }
  .hero-concept { margin: 1.7rem 0; color: var(--paper-dim); font-family: var(--mono); font-size: .67rem; letter-spacing: .09em; text-transform: uppercase; }
  .profile-links { display: flex; flex-wrap: wrap; gap: .55rem 1.2rem; max-width: 30rem; }
  .profile-links a { color: var(--paper-soft); font-family: var(--mono); font-size: .67rem; letter-spacing: .06em; text-transform: uppercase; }
  .hero-visual { position: relative; min-width: 0; }
  .portrait { position: absolute; right: -1rem; bottom: -1.6rem; display: flex; gap: .8rem; align-items: end; margin: 0; }
  .portrait img { width: 5.75rem; height: 5.75rem; border: 1px solid var(--rule-strong); filter: grayscale(1) contrast(1.04); object-fit: cover; }
  .portrait figcaption { padding-bottom: .25rem; color: var(--paper-dim); font-family: var(--mono); font-size: .6rem; letter-spacing: .08em; text-transform: uppercase; }
  blockquote { grid-column: 1 / -1; max-width: 51rem; margin: 1rem 0 0 auto; padding: 0 0 0 2rem; border-left: 1px solid var(--amber); color: var(--paper); font-family: var(--serif); font-size: clamp(1.55rem,3vw,2.65rem); font-style: italic; line-height: 1.18; }
  .about h2 { margin-bottom: 2.8rem; }
  .about-copy { max-width: 49rem; text-align: left; hyphens: auto; }
  .about-copy .lead { color: var(--paper); font-family: var(--serif); font-size: clamp(1.35rem,2.3vw,1.9rem); line-height: 1.38; }
  .updates { margin: 0; padding: 0; list-style: none; }
  .updates li { display: grid; grid-template-columns: 8rem minmax(0,1fr); gap: clamp(1.5rem,5vw,6rem); padding: 1.8rem 0; border-top: 1px solid var(--rule); }
  .updates li:last-child { border-bottom: 1px solid var(--rule); }
  .updates time { color: var(--amber); font-family: var(--mono); font-size: .68rem; letter-spacing: .07em; text-transform: uppercase; }
  .updates p { max-width: 52rem; margin: 0; color: var(--paper-soft); }
  .updates .text-link { margin-top: .8rem; }
  .secondary-strand { display: grid; grid-template-columns: .42fr 1.4fr; gap: clamp(3rem,8vw,10rem); padding: var(--space-section) 0; border-top: 1px solid var(--rule); }
  .strand-marker { display: flex; gap: 1rem; align-items: center; min-height: 13rem; }
  .strand-marker i { width: .55rem; height: .55rem; border: 1px solid var(--indigo); border-radius: 50%; }
  .strand-marker i:nth-child(1) { opacity: .35; }.strand-marker i:nth-child(2) { opacity: .65; }.strand-marker i:nth-child(3) { background: var(--amber); border-color: var(--amber); }
  .strand-marker::before, .strand-marker::after { height: 1px; flex: 1; background: var(--rule); content: ''; }
  .secondary-strand h2 { max-width: 15ch; margin: 1rem 0 1.4rem; font-size: clamp(2.3rem,5vw,4.5rem); }
  .secondary-strand > div:last-child > p:last-child { max-width: 43rem; }
  .strand-meta { color: var(--amber); font-family: var(--mono); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; }
  @media (max-width: 1000px) { .home-hero { grid-template-columns: 1fr; } .hero-copy { max-width: 42rem; } .hero-visual { width: 100%; } }
  @media (max-width: 760px) { .home-hero { padding-top: 3.5rem; } .hero-copy h1 { font-size: clamp(3.65rem,17vw,5.4rem); } .hero-visual { margin-top: 1rem; } .portrait { right: .5rem; } blockquote { margin-top: 2rem; } .updates li { grid-template-columns: 1fr; gap: .6rem; } .secondary-strand { grid-template-columns: 1fr; gap: 2rem; } .strand-marker { min-height: auto; } }
</style>
